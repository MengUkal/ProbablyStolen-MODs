<Project Sdk="Microsoft.NET.Sdk">

  <!-- 快速卷帘门 (fast.shutter) —— Probably Stolen 深空当铺
       功能：开张/打烊的卷帘门动画加速（时长可在设置页调节）
       原理：Harmony Prefix 改写 StoreShutterButton.duration 私有字段（原版 2.75s） -->

  <PropertyGroup>
    <GameRoot>D:\steamwork\steamapps\common\Probably Stolen</GameRoot>
    <ManagedDir>$(GameRoot)\Probably Stolen_Data\Managed</ManagedDir>

    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>FastShutter</AssemblyName>
    <RootNamespace>FastShutter</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <DebugType>portable</DebugType>
    <NoWarn>$(NoWarn);CS0414;CS0649;CS0067</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ManagedDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
